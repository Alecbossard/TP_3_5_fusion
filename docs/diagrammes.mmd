%% Diagramme de classes
classDiagram
class App {
 +poll()
 +render()
}
class Transport {
 +send(message)
 +feedback(message)
}
class FusionEngine {
 +speech(phrase, confidence)
 +gesture(name, confidence)
 +point(x, y)
 +validate()
 +tick()
 +reset()
}
class FusionData {
 action
 shape
 color
 source
 target
 color_point
 references
 points
 origins
 last
 +assign(key, value, modality)
 +modalities()
 +reset()
}
class Scene {
 objects
 +create(shape, color, position)
 +select(point, shape, color)
}
class Object {
 id
 shape
 color
 x
 y
 +contains(x, y)
}
class Recognizer {
 templates
 +learn(name, points)
 +recognize(points)
}
App --> Transport
App --> FusionEngine
App --> Recognizer
FusionEngine *-- FusionData
FusionEngine --> Scene
Scene *-- Object

%% Machine à états (copier séparément dans un éditeur Mermaid)
stateDiagram-v2
 [*] --> REPOS
 REPOS --> COLLECTE: entrée valide
 COLLECTE --> COLLECTE: complément valide
 COLLECTE --> ATTENTE: valider / incomplet ou monomodal
 ATTENTE --> COLLECTE: complément
 COLLECTE --> EXECUTION: valider / garde satisfaite
 ATTENTE --> EXECUTION: valider / garde satisfaite
 EXECUTION --> AMBIGUITE: sélection non unique
 AMBIGUITE --> COLLECTE: précision de forme ou couleur
 EXECUTION --> REPOS: création ou déplacement, reset
 COLLECTE --> ERREUR: contradiction ou prélèvement vide
 ATTENTE --> ERREUR: contradiction ou prélèvement vide
 ERREUR --> REPOS: annuler ou délai
 COLLECTE --> REPOS: annuler ou délai
 ATTENTE --> REPOS: annuler ou délai
 AMBIGUITE --> REPOS: annuler ou délai

